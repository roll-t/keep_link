<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Chỉ tin tưởng CA của hệ thống (không trust user-installed certs).
        Đây là mặc định của Android 7+, khai báo tường minh để rõ ràng.
    -->
    <!-- Link do người dùng lưu có thể là HTTP cũ. WebView cần quyền tải các
         trang đó; API/backend của ứng dụng vẫn sử dụng HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Cho phép debug (Charles Proxy / Wireshark) trên debug build.
        Release build KHÔNG có block này → an toàn.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
