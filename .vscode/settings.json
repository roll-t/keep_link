{
  "dart.flutterSdkPath": ".fvm/versions/3.38.3",
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "[dart]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true
  },
  "dart.analysisExcludedFolders": [
    "build/",
    ".dart_tool/",
    ".fvm/",
    "ios/Flutter",
    "android/app/build"
  ],
  "dart.lineLength": 100,
  "dart.allowTestsOutsideTestFolder": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "dart.imports.sortMembers": true,
  "dart.showTodos": true,
  "dart.flutterHotReloadOnSave": true,
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "cSpell.words": [
    "chép",
    "Getx",
    "Rxn",
    "usecase",
    "viewmodel",
    "widget"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.dart_tool": true,
    "**/.fvm": true,
    "**/build": true,
    "**/ios/Flutter": true,
    "**/android/app/build": true
  },
  "search.exclude": {
    "**/.dart_tool": true,
    "**/.fvm": true,
    "**/build": true
  }
}